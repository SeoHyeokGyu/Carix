# 라우터 Caddy(~/infra)가 import하는 Carix 항목.
# 라우터는 TLS 종료와 호스트명 분기만 하고, 애플리케이션 라우팅은 carix_caddy가 맡는다.
#
# 인증서는 sslip.io 와일드카드 DNS + 자동 ACME로 발급된다.
carix.144.24.90.88.sslip.io {
	encode zstd gzip
	reverse_proxy carix_caddy:80
}

# Headscale 컨트롤 서버. Tailscale 클라이언트가 여기로 붙는다.
# TLS 는 라우터가 종료하고 평문으로 넘긴다 — headscale 은 인증서를 다루지 않는다.
headscale.144.24.90.88.sslip.io {
	reverse_proxy carix_headscale:8080
}
