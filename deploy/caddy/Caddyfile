# Carix 전용 Caddy. 애플리케이션 라우팅만 담당한다.
#
# TLS 종료와 도메인 분기는 서버의 라우터 Caddy(~/infra)가 처리하고, 이 컨테이너는
# edge 네트워크를 통해 평문 HTTP로 요청을 받는다. 따라서 인증서를 발급하지 않는다.
{
	auto_https off
	servers {
		# 라우터가 붙여 보낸 X-Forwarded-* 를 신뢰한다. Docker 브리지는 사설 대역이다.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy spring-api:8080
	}

	# 정적 assets — 프런트엔드 스캐폴드 후 실제 경로에 맞춰 확정한다.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy frontend-node:3000
	}

	handle {
		reverse_proxy frontend-node:3000
	}
}
