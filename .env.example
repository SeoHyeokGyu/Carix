# Carix 환경 변수 예시. 실제 .env는 커밋하지 않는다 (.gitignore 처리됨).
# 값을 채워 .env로 복사한다. 시크릿은 저장소·로그에 남기지 않는다.

# --- 배포 이미지 태그 (서버 전용) ---
# 배포 워크플로가 커밋 SHA로 덮어쓴다. 컴포넌트별로 나뉘어 있어, 한쪽만 바뀐 커밋에서는
# 그쪽 태그만 갱신되고 반대쪽 컨테이너는 재생성되지 않는다.
#
# `latest` 대신 SHA로 고정하는 이유는 롤백이 아니라 관측성과 재현성이다.
# 이 두 줄만 보면 지금 어떤 커밋이 돌고 있는지 확정되고, 서버를 재기동해도 같은 것이 뜬다.
# 자동 롤백은 없다. 되돌리려면 값을 직전 SHA로 바꾸고 `docker compose up -d`.
CORE_API_TAG=latest
FRONTEND_TAG=latest
EUREKA_TAG=latest
CONFIG_SERVER_TAG=latest

# --- PostgreSQL (OCI 서버 전용) ---
POSTGRES_DB=carix
POSTGRES_USER=carix
POSTGRES_PASSWORD=

# --- 로컬 개발용 백엔드 DataSource ---
# 로컬엔 Postgres를 띄우지 않는다. Headscale tailnet 으로 OCI 의 DB 에 연결한다.
#
# 운영과 개발이 같은 DB 다 (근거는 docs/DEVELOPMENT.md §3). 여기 쓰는 쿼리·마이그레이션이 곧 운영에 적용된다.
# 계정은 팀원별로 발급받는다 — 공용 계정을 돌려쓰지 않는다 (DEVELOPMENT.md §3.0).
#
# 접근은 Tailscale 이다. 클라이언트가 켜져 있으면 터널 명령 없이 붙는다.
# 호스트는 서버의 tailnet 이름 (tailscale status 로 확인).
SPRING_DATASOURCE_URL=jdbc:postgresql://<서버-tailnet-이름>:5432/carix
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- 애플리케이션 레벨 컬럼 암호화 (AES-256-GCM) ---
# 32바이트 키의 base64. 예: openssl rand -base64 32
CARIX_ENCRYPTION_KEY=

# --- 외부 데이터 원천 API 키 (배치 워커) ---
# 선행 검증에서 발급·약관 확인 후 채운다.
KOSIS_API_KEY=
WORK24_API_KEY=
SARAMIN_API_KEY=
WAGE_STAT_API_KEY=
