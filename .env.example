# Carix 환경 변수 예시. 실제 .env는 커밋하지 않는다 (.gitignore 처리됨).
# 값을 채워 .env로 복사한다. 시크릿은 저장소·로그에 남기지 않는다.

# --- 배포 이미지 태그 (서버 전용) ---
# 배포 워크플로가 커밋 SHA로 덮어쓴다. 컴포넌트별로 나뉘어 있어, 한쪽만 바뀐 커밋에서는
# 그쪽 태그만 갱신되고 반대쪽 컨테이너는 재생성되지 않는다.
#
# `latest` 대신 SHA로 고정하는 이유는 롤백이 아니라 관측성과 재현성이다.
# 이 두 줄만 보면 지금 어떤 커밋이 돌고 있는지 확정되고, 서버를 재기동해도 같은 것이 뜬다.
# 자동 롤백은 없다. 되돌리려면 값을 직전 SHA로 바꾸고 `docker compose up -d`.
CORE_API_TAG=latest
FRONTEND_TAG=latest
EUREKA_TAG=latest
CONFIG_SERVER_TAG=latest
GATEWAY_TAG=latest
AUTH_SERVICE_TAG=latest

# --- PostgreSQL (OCI 서버 전용) ---
POSTGRES_DB=carix
POSTGRES_USER=carix
POSTGRES_PASSWORD=

# --- 로컬 개발용 백엔드 DataSource ---
# 로컬엔 Postgres를 띄우지 않는다. OCI 의 DB 에 원격 연결한다.
#
# 운영과 개발이 같은 DB 다 (근거는 docs/DEVELOPMENT.md §3). 여기 쓰는 쿼리·마이그레이션이 곧 운영에 적용된다.
# 계정은 팀원별로 발급받는다 — 공용 계정을 돌려쓰지 않는다 (DEVELOPMENT.md §3.0).
#
# 접근은 TLS + OCI Security List IP 허용목록이다 — 접속 전 IP를 Security List에
# 등록해야 한다(DEVELOPMENT.md §3.0). 자체 서명 인증서라 sslmode=require를 쓴다
# (verify-full은 인증서 체인 검증에 실패한다).
SPRING_DATASOURCE_URL=jdbc:postgresql://144.24.90.88:5432/carix?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- 애플리케이션 레벨 컬럼 암호화 (AES-256-GCM) ---
# 32바이트 키의 base64. 예: openssl rand -base64 32
CARIX_ENCRYPTION_KEY=

# --- 매직링크 메일 발송 (Gmail SMTP) ---
# 앱 비밀번호는 2단계 인증을 켠 계정에서만 발급된다:
#   myaccount.google.com > 보안 > 2단계 인증 > 앱 비밀번호
# 계정 비밀번호가 아니라 발급받은 16자를 넣는다(공백은 빼도 된다).
# MAIL_HOST 가 비면 매직링크가 실제로 발송되지 않고 로그로만 남는다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Carix
# 매직링크의 앞부분. 프런트엔드 진입점이다 (끝에 / 를 붙이지 않아도 된다).
MAIL_BASE_URL=https://carix.144.24.90.88.sslip.io

# --- 운영자 전용 내부 경로 공유 시크릿 ---
# auth-service 의 /internal/** (초대 등록 등) 접근 키. 예: openssl rand -base64 32
# 비워 두면 해당 경로가 전부 403 이 된다 (fail closed).
AUTH_INTERNAL_API_KEY=

# --- 외부 데이터 원천 API 키 (배치 워커) ---
# 선행 검증에서 발급·약관 확인 후 채운다.
KOSIS_API_KEY=
WORK24_API_KEY=
SARAMIN_API_KEY=
WAGE_STAT_API_KEY=
