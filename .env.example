# Carix 환경 변수 예시. 실제 .env는 커밋하지 않는다 (.gitignore 처리됨).
# 값을 채워 .env로 복사한다. 시크릿은 저장소·로그에 남기지 않는다.

# --- 배포 이미지 태그 (서버 전용) ---
# 배포 워크플로가 커밋 SHA로 덮어쓴다. 롤백은 이 값을 이전 SHA로 바꾸고 `docker compose up -d`.
IMAGE_TAG=latest

# --- PostgreSQL (OCI 서버 전용) ---
POSTGRES_DB=carix
POSTGRES_USER=carix
POSTGRES_PASSWORD=

# dev 스키마용 롤 비밀번호. initdb 스크립트가 carix_dev 롤·DB를 만들 때 쓴다.
CARIX_DEV_PASSWORD=

# --- 로컬 개발용 백엔드 DataSource (OCI dev DB 원격 연결) ---
# 로컬엔 Postgres를 띄우지 않는다. OCI의 dev 스키마에 SSH 터널로 연결한다.
# ssh -N -L 5432:localhost:5432 carix-oci
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carix_dev
SPRING_DATASOURCE_USERNAME=carix_dev
SPRING_DATASOURCE_PASSWORD=

# --- 애플리케이션 레벨 컬럼 암호화 (AES-256-GCM) ---
# 32바이트 키의 base64. 예: openssl rand -base64 32
CARIX_ENCRYPTION_KEY=

# --- 외부 데이터 원천 API 키 (배치 워커) ---
# 선행 검증에서 발급·약관 확인 후 채운다.
KOSIS_API_KEY=
WORK24_API_KEY=
SARAMIN_API_KEY=
WAGE_STAT_API_KEY=
