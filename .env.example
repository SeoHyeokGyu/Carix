# Carix 환경 변수 예시. 실제 .env는 커밋하지 않는다 (.gitignore 처리됨).
# 값을 채워 .env로 복사한다. 시크릿은 저장소·로그에 남기지 않는다.

# --- 배포 이미지 태그 (서버 전용) ---
# 배포 워크플로가 커밋 SHA로 덮어쓴다. 컴포넌트별로 나뉘어 있어, 한쪽만 바뀐 커밋에서는
# 그쪽 태그만 갱신되고 반대쪽 컨테이너는 재생성되지 않는다.
#
# `latest` 대신 SHA로 고정하는 이유는 관측성과 재현성이다.
# 이 줄들만 보면 지금 어떤 커밋이 돌고 있는지 확정되고, 서버를 재기동해도 같은 것이 뜬다.
# 배포 실패 시 deploy.yml 이 직전 .env 로 자동 롤백하며, 수동 복구는 rollback.yml 워크플로를 쓴다.
CORE_API_TAG=latest
FRONTEND_TAG=latest
EUREKA_TAG=latest
CONFIG_SERVER_TAG=latest
GATEWAY_TAG=latest
AUTH_SERVICE_TAG=latest
COLLECTOR_TAG=latest

# --- PostgreSQL (OCI 서버 전용) ---
POSTGRES_DB=carix
POSTGRES_USER=carix
POSTGRES_PASSWORD=

# --- 로컬 개발용 백엔드 DataSource ---
# 로컬엔 Postgres를 띄우지 않는다. OCI 의 DB 에 원격 연결한다.
#
# 운영과 개발이 같은 DB 다 (근거는 docs/DEVELOPMENT.md §3). 여기 쓰는 쿼리·마이그레이션이 곧 운영에 적용된다.
# 계정은 팀원별로 발급받는다 — 공용 계정을 돌려쓰지 않는다 (DEVELOPMENT.md §3.0).
#
# 접근은 TLS + OCI Security List IP 허용목록이다 — 접속 전 IP를 Security List에
# 등록해야 한다(DEVELOPMENT.md §3.0). 자체 서명 인증서라 sslmode=require를 쓴다
# (verify-full은 인증서 체인 검증에 실패한다).
SPRING_DATASOURCE_URL=jdbc:postgresql://144.24.90.88:5432/carix?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- 애플리케이션 레벨 컬럼 암호화 (AES-256-GCM, SECURITY §3.2) ---
# [단일 키 운영 시] 32바이트 키의 base64. 생성: openssl rand -base64 32
CARIX_ENCRYPTION_KEY=
# [키 로테이션 시] 다중 키 링 (형식: v1:base64Key1,v2:base64Key2) 및 신규 활성 키 ID
# CARIX_ENCRYPTION_KEYS=v1:...,v2:...
# CARIX_ENCRYPTION_ACTIVE_KEY_ID=v2
# [재암호화] true 면 core-api 기동 후 구 암호문을 활성 키로 재암호화한다. 로그 rekey-status 의 fullyMigrated=true 확인 뒤 끈다
# CARIX_ENCRYPTION_REKEY_ON_STARTUP=false

# --- 외부 데이터 원천 API 키 및 수집기 관리자 키 (collector) ---
# KOSIS OpenAPI 인증키 (CPI·임금통계 수집용)
KOSIS_API_KEY=
# collector 관리자 콘솔(/admin/collector, /admin/data) 및 내부 파이프라인 API 호출 키 (X-Admin-Key)
CARIX_ADMIN_KEY=
