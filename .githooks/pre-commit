#!/bin/sh
# Carix Git pre-commit Hook
# 1) 백엔드: 변경된 .java 파일에 대해 Google Java Format(Spotless) 자동 적용 및 스테이징
# 2) 프런트엔드: 변경된 frontend/ 파일에 대해 Prettier 자동 적용 및 스테이징

STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)
if [ -n "$STAGED_JAVA_FILES" ]; then
  echo "🎨 [Backend] Google Java Format 적용 중 (spotlessApply)..."
  (cd backend && ./gradlew spotlessApply --quiet)

  for FILE in $STAGED_JAVA_FILES; do
    git add "$FILE"
  done
  echo "✅ [Backend] Google Java Format 적용 완료."
fi

STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/.*\.\(ts\|tsx\|js\|jsx\|css\|json\)$' || true)
if [ -n "$STAGED_FRONTEND_FILES" ]; then
  echo "🎨 [Frontend] Prettier 포맷팅 적용 중..."
  (cd frontend && pnpm format)

  for FILE in $STAGED_FRONTEND_FILES; do
    git add "$FILE"
  done
  echo "✅ [Frontend] Prettier 포맷팅 적용 완료."
fi

exit 0
