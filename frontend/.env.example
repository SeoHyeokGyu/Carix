# ==============================================================================
# Carix 프론트엔드 로컬 개발 환경설정 (.env 또는 .env.local 로 복사하여 사용)
# ==============================================================================

# [기본값: 원격 OCI 배포 서버 연결]
# 로컬에 백엔드를 띄우지 않아도 실서버 백엔드와 통신합니다. (생략 시 기본 적용)
CARIX_API_TARGET=https://carix.144.24.90.88.sslip.io

# [옵션 1: 로컬 게이트웨이 전체 연동 (localhost:8080)]
# 로컬에서 Gateway, core-api, auth-service, collector를 모두 실행했을 때 주석 해제:
# CARIX_API_TARGET=http://localhost:8080

# [옵션 2: 게이트웨이 없이 로컬 collector 서비스 단독 연동 (localhost:8083)]
# 게이트웨이를 띄우지 않고 로컬 collector만 띄운 상태로 관리자 화면을 개발할 때 주석 해제:
# (Vite가 /api/v1/admin/collector -> /internal/pipeline 으로 자동 rewrite합니다)
# CARIX_COLLECTOR_TARGET=http://localhost:8083

# [옵션 3: 게이트웨이 없이 로컬 core-api 서비스 단독 연동 (localhost:8082)]
# CARIX_API_TARGET=http://localhost:8082
